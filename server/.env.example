DATABASE_URL=postgresql://holyapp:holyapp_dev@localhost:5432/holyapp_db
JWT_SECRET=
# 64 hex characters (32 bytes) for AES-256-GCM at rest. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
BCRYPT_SALT_ROUNDS=12
PORT=5000
# Localhost is rewritten to your Wi-Fi IP in reset emails so a phone on the same network can open the link.
FRONTEND_URL=http://localhost:5173
AUTH_DEBUG=false
# Email. On a host that blocks outgoing SMTP (Railway below the Pro plan), set BREVO_API_KEY: emails then
# go through Brevo's HTTPS API (free up to 300 a day) from the SMTP_FROM address, which must be a verified
# sender in Brevo. Without it, the SMTP_* settings below are used (e.g. Gmail with an App Password).
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HolyApp <your-gmail@gmail.com>
# Parishioners get an email (through the SMTP settings above) whenever the parish office changes the
# status of their certificate request, marriage application (including banns steps) or Mass intention.
# The email links to FRONTEND_URL. Set to false to stop these emails. Without SMTP_USER/SMTP_PASS they are
# skipped and logged (with AUTH_DEBUG=true the whole email is printed to the console instead).
STATUS_EMAILS=true
# Where the landing page's Book a demo requests are sent (placeholder until HolyApp has its real address)
HOLYAPP_CONTACT_INBOX=contact@holyapp.example
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Reading register photos (Digitized Ledger → Read a register photo). Leave the key empty to
# turn the feature off. Use a key from a Google Cloud project WITH BILLING enabled: on the
# free tier Google may use what is sent (names, dates of birth) to improve its products.
GEMINI_API_KEY=
# Optional: which Gemini model reads the photos.
GEMINI_MODEL=
# Optional: how many photos one person may read per hour (default 40).
LEDGER_SCAN_READS_PER_HOUR=
# Development only: keep Gemini's answers in this folder so re-reading a test photo is free.
# Leave unset on a real server (the answers hold people's names).
GEMINI_CACHE_DIR=
