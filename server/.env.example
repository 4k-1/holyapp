DATABASE_URL=postgresql://holyapp:holyapp_dev@localhost:5432/holyapp_db
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
BCRYPT_SALT_ROUNDS=12
PORT=5000
# Localhost is rewritten to your Wi-Fi IP in reset emails so a phone on the same network can open the link.
FRONTEND_URL=http://localhost:5173
AUTH_DEBUG=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HolyApp <your-gmail@gmail.com>
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Reading register photos (Digitized Ledger → Read a register photo). Leave the key empty to
# turn the feature off. Use a key from a Google Cloud project WITH BILLING enabled: on the
# free tier Google may use what is sent (names, dates of birth) to improve its products.
GEMINI_API_KEY=
# Optional: which Gemini model reads the photos.
GEMINI_MODEL=
# Optional: how many photos one person may read per hour (default 40).
LEDGER_SCAN_READS_PER_HOUR=
# Development only: keep Gemini's answers in this folder so re-reading a test photo is free.
# Leave unset on a real server (the answers hold people's names).
GEMINI_CACHE_DIR=
